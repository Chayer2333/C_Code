{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Setup-MSVC-env",
            "type": "shell",
            "command": "echo 正在尝试设置MSVC环境... && call \"C:\\Program Files (x86)\\Microsoft Visual Studio\\2022\\BuildTools\\VC\\Auxiliary\\Build\\vcvarsall.bat\" x64 && echo 环境设置成功！ || echo 环境设置失败！",
            "args": [],
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/c"
                    ]
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "isBackground": true
        },
        {
            "label": "猫猫抛来一个程序喵",
            "type": "cppbuild",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/Fo:Buffer/",
                "/Fd:Buffer/",
                "/FeEXE/${fileBasenameNoExtension}_MSVC.exe",
                "${file}",
                "/link",
                "/INCREMENTAL",
                "/ILK:Buffer/${fileBasenameNoExtension}.ilk",
                "/PDB:Buffer/${fileBasenameNoExtension}.pdb",
                "/DEBUG"
            ],
            "options": {
                "cwd": "E:/8_Buffer/C_Compile/MSVC"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译器: cl.exe"
        },
        {
            "label": "TDM-GCC C17标准",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.vscode/Auto_Clean.ps1",
                "${file}"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "使用独立TDM-GCC编译，标准C17"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe 生成活动文件",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/Fo:Buffer/",
                "/Fd:Buffer/",
                "/FeEXE/${fileBasenameNoExtension}_MSVC.exe",
                "${file}",
                "/link",
                "/INCREMENTAL",
                "/ILK:Buffer/${fileBasenameNoExtension}.ilk",
                "/PDB:Buffer/${fileBasenameNoExtension}.pdb",
                "/DEBUG"
            ],
            "options": {
                "cwd": "E:/8_Buffer/C_Compile/MSVC"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build",
            "detail": "调试器生成的任务。"
        }
    ]
}